# Personal Skills Development / Reference Build
# Copy to .env.local for local-only values. Do not commit real secrets.
# Browser-safe display metadata and Supabase publishable configuration only.
# Supported VITE_APP_ENV values: local-development, reference, test.
# Do not place service-role keys, database passwords, access tokens, or other secrets here.

VITE_APP_ENV=local-development
VITE_APP_VERSION=0.0.0-foundation
VITE_APP_STATUS_LABEL=Personal Skills Development / Reference Build
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_browser_safe_key
